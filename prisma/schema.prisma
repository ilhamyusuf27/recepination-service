generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id       String   @id @default(uuid()) @db.Uuid
  name          String
  phone_number  String?
  email         String   @unique
  password      String
  email_token   String?
  is_verified   Boolean  @default(false)
  photo_profile String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  recipes   Recipe[]
  favorites Favorite[]
  comments  Comment[]
}

model Recipe {
  recipe_id    String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  title        String
  description  String
  instructions String[]
  image_url    String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user        User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  ingredients Ingredient[]
  favorites   Favorite[]
  categories  RecipeCategory[]
  comments    Comment[]
}

model Ingredient {
  id       String  @id @default(uuid()) @db.Uuid
  recipeId String  @db.Uuid
  name     String
  quantity String?

  recipe Recipe @relation(fields: [recipeId], references: [recipe_id], onDelete: Cascade)
}

model Category {
  category_id String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  recipes RecipeCategory[]
}

model RecipeCategory {
  recipeId   String @db.Uuid
  categoryId String @db.Uuid

  recipe   Recipe   @relation(fields: [recipeId], references: [recipe_id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [category_id], onDelete: Cascade)

  @@id([recipeId, categoryId])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  recipeId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [recipe_id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model Comment {
  comment_id String   @id @default(uuid()) @db.Uuid
  content    String
  userId     String   @db.Uuid
  recipeId   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [recipe_id], onDelete: Cascade)

  @@index([recipeId])
  @@index([userId])
}
